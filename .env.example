# Copy to .env and fill in real values. Never commit .env.

# --- Tractive account ---
TRACTIVE_USERNAME=you@example.com
TRACTIVE_PASSWORD=your-tractive-password
# Tractive's own public API client id (see README.md Credits) — the same
# value the open-source aiotractive library uses, not a per-account secret.
TRACTIVE_CLIENT_ID=625e533dc3c3b41c28a669f0
# REQUIRED — the bridge does not discover this on its own. See "Finding your
# TRACTIVE_USER_ID" in README.md.
TRACTIVE_USER_ID=your-24-char-tractive-user-id

# --- MQTT broker ---
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USER=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password

# --- Bridge behavior ---
FAST_POLL_INTERVAL=90
MED_POLL_INTERVAL=300
SLOW_POLL_INTERVAL=3600
INTER_CALL_DELAY=0.4
POSITION_BACKFILL_HOURS=24
EVENT_BACKFILL_DAYS=30
EVENT_TIMEZONE=UTC
CHANNEL_ENABLED=1
HA_DISCOVERY_PREFIX=homeassistant
MQTT_TOPIC_PREFIX=tractive
LOG_LEVEL=INFO

# --- Optional: production-error reporting via GitHub repository_dispatch ---
# Leave both unset to disable. See _shared/python-github-error-reporter/README.md.
GITHUB_ERROR_TOKEN=
GITHUB_REPO=
GITHUB_ERROR_ENVIRONMENT=production
